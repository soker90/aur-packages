{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "enabled": true
    },
    {
      "matchPackageNames": ["stacklok/toolhive-studio", "github/app"],
      "postUpgradeTasks": {
        "commands": ["bash scripts/renovate-update-aur-metadata.sh {{{packageFile}}}"],
        "fileFilters": [
          "toolhive-studio-bin/PKGBUILD",
          "toolhive-studio-bin/.SRCINFO",
          "github-copilot-app-bin/PKGBUILD",
          "github-copilot-app-bin/.SRCINFO"
        ],
        "executionMode": "update"
      }
    }
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "prConcurrentLimit": 1,
  "prHourlyLimit": 2
}
