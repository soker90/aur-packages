{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "enabled": true
    },
    {
      "matchPackageNames": ["stacklok/toolhive-studio", "github/app"],
      "postUpgradeTasks": {
        "commands": ["node scripts/renovate-update-aur-checksum.mjs {{{packageFile}}}"],
        "fileFilters": [
          "toolhive-studio-bin/PKGBUILD",
          "github-copilot-app-bin/PKGBUILD"
        ],
        "executionMode": "update"
      }
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^toolhive-studio-bin/PKGBUILD$/"],
      "matchStrings": ["pkgver=(?<currentValue>.*?)\\n"],
      "depNameTemplate": "stacklok/toolhive-studio",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^github-copilot-app-bin/PKGBUILD$/"],
      "matchStrings": ["pkgver=(?<currentValue>.*?)\\n"],
      "depNameTemplate": "github/app",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "prConcurrentLimit": 1,
  "prHourlyLimit": 2
}
